# Copy to web/.env.local and fill in. Never commit real values.

# MongoDB. Local dev instance: `cd web && pnpm db:start` (port 27018, no auth).
# Compass connection string: mongodb://localhost:27018
MONGODB_URI=mongodb://127.0.0.1:27018/ai-sims

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# AI providers (phase 4, server-side only)
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=

# TTS (phase 4, server-side only)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
