# Copy to web/.env.local and fill in. Never commit real values.
# Step-by-step account setup (Turkish): docs/setup-accounts.md

# MongoDB. Local dev instance: `cd web && pnpm db:start` (port 27018, no auth).
# Compass connection string: mongodb://localhost:27018
MONGODB_URI=mongodb://127.0.0.1:27018/ai-sims

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# AI chat (server-side only). Every variable below is optional: leave a key
# empty and that provider is skipped; with none set, /api/chat answers 503.
# ---------------------------------------------------------------------------

# Anthropic (Claude). Key: Claude Console > API keys (https://platform.claude.com/settings/keys)
ANTHROPIC_API_KEY=
# Model override. Default: claude-opus-5-5
ANTHROPIC_MODEL=

# Google Gemini. Key: Google AI Studio > API keys (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Model override. Default: gemini-3.8-flash
GEMINI_MODEL=

# Groq. Key: GroqCloud console > API Keys (https://console.groq.com/keys)
GROQ_API_KEY=
# Model override. Default: openai/gpt-oss-120b
GROQ_MODEL=

# Order in which providers are tried (comma-separated). A provider is only
# skipped for the next one if it fails before its first token.
# Default: anthropic,gemini,groq
AI_PROVIDER_ORDER=

# ---------------------------------------------------------------------------
# Text to speech: Azure Speech (server-side only). Optional.
# Key and region: Azure portal > your Speech resource > Keys and Endpoint
# (KEY 1 and Location/Region, e.g. westeurope)
# ---------------------------------------------------------------------------
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Voice overrides (standard neural voices). Defaults when left empty:
#   Turkish female tr-TR-EmelNeural, Turkish male tr-TR-AhmetNeural,
#   English female en-US-AvaNeural, English male en-US-AndrewNeural
# Voice list: https://learn.microsoft.com/azure/ai-services/speech-service/language-support?tabs=tts
AZURE_TTS_VOICE_TR_FEMALE=
AZURE_TTS_VOICE_TR_MALE=
AZURE_TTS_VOICE_EN_FEMALE=
AZURE_TTS_VOICE_EN_MALE=
